generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  confirmed Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  habitats  Habitat[]
  @@map("users")
}

model Habitat {
  id          Int     @id @default(autoincrement())
  title       String
  description String?
  userId      Int
  user        User    @relation(fields: [userId], references: [id])
  telemetry   Telemetry[]
  apiKeys     ApiKey[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("habitats")
}

model Telemetry {
  id Int @id @default(autoincrement())

  habitatId Int
  habitat   Habitat @relation(fields: [habitatId], references: [id])

  recordedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  temperature Float
  humidity    Float
  vpd         Float

  @@index([habitatId, recordedAt])
  @@map("telemetries")
}

model ApiKey {
  id          Int      @id @default(autoincrement())
  name        String
  keyHash     String   @unique
  isActive    Boolean  @default(true)
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  habitatId   Int
  habitat     Habitat  @relation(fields: [habitatId], references: [id])

  @@map("api_keys")
}
