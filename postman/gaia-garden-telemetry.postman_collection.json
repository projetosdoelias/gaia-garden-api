              "raw": "{{gg_url}}/habitat/{{habitat_id}}/telemetry/series?from=2026-11-01T00:00:00-03:00&to=2026-11-02T00:00:00-03:00",
              "host": [
                "{{gg_url}}"
              ],
              "path": [
                "habitat",
                "{{habitat_id}}",
                "telemetry",
                "series"
              ],
              "query": [
                {
                  "key": "from",
                  "value": "2026-11-01T00:00:00-03:00"
                },
                {
                  "key": "to",
                  "value": "2026-11-02T00:00:00-03:00"
                }
              ]
            },
            "description": ""
          },
          "response": []
        }
      ]
    },
    {
      "name": "List (cursor pagination)",
      "item": [
        {
          "name": "List – first page",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('has page shape', () => pm.expect(body).to.have.keys('data','nextCursor'));",
                  "pm.collectionVariables.set('next_cursor', body.nextCursor ?? '');",
                  "console.log('next_cursor =', body.nextCursor);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gg_url}}/habitat/{{habitat_id}}/telemetry?limit=50&from=2026-11-18T00:00:00Z&to=2026-11-19T00:00:00Z",
              "host": [
                "{{gg_url}}"
              ],
              "path": [
                "habitat",
                "{{habitat_id}}",
                "telemetry"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "50",
                  "description": "1–200. Default 50"
                },
                {
                  "key": "from",
                  "value": "2026-11-18T00:00:00Z",
                  "description": "Optional filter, inclusive",
                  "disabled": true
                },
                {
                  "key": "to",
                  "value": "2026-11-19T00:00:00Z",
                  "description": "Optional filter, exclusive",
                  "disabled": true
                }
              ]
            },
            "description": "Saves `nextCursor` into the `next_cursor` collection variable. Enable `from`/`to` to filter."
          },
          "response": []
        },
        {
          "name": "List – next page",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('has page shape', () => pm.expect(body).to.have.keys('data','nextCursor'));",
                  "pm.collectionVariables.set('next_cursor', body.nextCursor ?? '');",
                  "console.log('next_cursor =', body.nextCursor);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gg_url}}/habitat/{{habitat_id}}/telemetry?limit=50&cursor={{next_cursor}}",
              "host": [
                "{{gg_url}}"
              ],
              "path": [
                "habitat",
                "{{habitat_id}}",
                "telemetry"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "50"
                },
                {
                  "key": "cursor",
                  "value": "{{next_cursor}}",
                  "description": "Value of nextCursor from the previous page"
                }
              ]
            },
            "description": "Run \"List – first page\" first. Run this repeatedly to walk pages; stops when nextCursor is null."
          },
          "response": []
        },
        {
          "name": "List – date range filter",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
