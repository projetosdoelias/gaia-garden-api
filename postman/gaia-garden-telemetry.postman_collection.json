                  "key": "from",
                  "value": "2026-11-18T00:00:00Z"
                },
                {
                  "key": "to",
                  "value": "2026-11-19T00:00:00Z"
                }
              ]
            },
            "description": ""
          },
          "response": []
        }
      ]
