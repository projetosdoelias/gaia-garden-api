                  "pm.collectionVariables.set('next_cursor', body.nextCursor ?? '');",
                  "console.log('next_cursor =', body.nextCursor);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gg_url}}/habitat/{{habitat_id}}/telemetry?limit=100&from=2026-11-18T00:00:00Z&to=2026-11-19T00:00:00Z",
