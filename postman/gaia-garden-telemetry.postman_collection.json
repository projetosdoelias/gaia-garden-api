{
  "info": {
    "name": "Gaia Garden – Habitat Telemetry",
    "description": "Telemetry series (aggregated) and paginated list routes.\n\nUses environment variables `gg_url` and `jwt_token`. Collection variables: `habitat_id` (your habitat), `other_habitat_id` (a habitat you do NOT own, for the 404 test), `next_cursor` (filled automatically by the list requests).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{jwt_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "habitat_id",
      "value": "1"
    },
    {
      "key": "other_habitat_id",
      "value": "9999"
    },
    {
      "key": "next_cursor",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Series",
      "item": [
        {
          "name": "Series – hourly, São Paulo (auto bucket)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('has series shape', () => {",
                  "  pm.expect(body).to.have.keys('habitatId','metric','bucket','from','to','tz','points');",
                  "  pm.expect(body.points).to.be.an('array');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gg_url}}/habitat/{{habitat_id}}/telemetry/series?from=2026-11-01T03:00:00Z&to=2026-11-02T03:00:00Z&tz=America/Sao_Paulo",
              "host": [
                "{{gg_url}}"
              ],
              "path": [
                "habitat",
                "{{habitat_id}}",
                "telemetry",
                "series"
              ],
              "query": [
                {
                  "key": "from",
                  "value": "2026-11-01T03:00:00Z",
                  "description": "Range start, inclusive (ISO 8601 with offset)"
                },
                {
                  "key": "to",
                  "value": "2026-11-02T03:00:00Z",
                  "description": "Range end, exclusive. Max 90 days after from"
                },
                {
                  "key": "tz",
                  "value": "America/Sao_Paulo",
                  "description": "IANA time zone. Default UTC"
                }
              ]
            },
            "description": "Range <= 48h, so bucket is picked as `hour`."
          },
          "response": []
        },
        {
          "name": "Series – daily, all params",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('has series shape', () => {",
                  "  pm.expect(body).to.have.keys('habitatId','metric','bucket','from','to','tz','points');",
                  "  pm.expect(body.points).to.be.an('array');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gg_url}}/habitat/{{habitat_id}}/telemetry/series?from=2026-10-20T00:00:00Z&to=2026-11-19T00:00:00Z&bucket=day&metric=vpd&tz=America/Sao_Paulo",
              "host": [
                "{{gg_url}}"
              ],
              "path": [
                "habitat",
                "{{habitat_id}}",
                "telemetry",
                "series"
              ],
              "query": [
                {
                  "key": "from",
                  "value": "2026-10-20T00:00:00Z"
                },
                {
                  "key": "to",
                  "value": "2026-11-19T00:00:00Z"
                },
                {
                  "key": "bucket",
                  "value": "day",
                  "description": "hour | day. Default: hour if range <= 48h, else day"
                },
                {
                  "key": "metric",
                  "value": "vpd",
                  "description": "Only vpd for now. Default vpd"
                },
                {
                  "key": "tz",
                  "value": "America/Sao_Paulo"
                }
              ]
            },
            "description": ""
          },
          "response": []
        },
        {
          "name": "Series – UTC default, numeric offset dates",
          "event": [
            {
              "listen": "test",
              "script": {
